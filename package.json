{
  "name": "claude-hub",
  "version": "0.1.0",
  "description": "A themeable real-time statusline HUD for Claude Code",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist/",
    "commands/",
    "scripts/",
    ".claude-plugin/"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test",
    "preview": "npm run build && node scripts/preview.mjs"
  },
  "keywords": ["claude-code", "statusline", "hud", "plugin"],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
